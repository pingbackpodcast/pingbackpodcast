#!/usr/bin/env ruby
# frozen_string_literal: true

# Local CI for the site, run by .githooks/pre-push before anything reaches
# GitHub (a push to main deploys). Fast on purpose: a few seconds.
#
#   1. Production build, strict front matter, no errors or warnings
#   2. Every episode has the front matter the templates need
#   3. Every episode's share card exists and is committed
#   4. No episode is dated in the future (Jekyll would silently skip it)
#      Chapters are in order; chapter and moment times fall inside the episode;
#      every moment has committed art; topic slugs exist in _data/topics.yml;
#      no TODOs left from `bin/episode new`
#   5. Every internal link and image in the built site resolves
#   6. The site test suite (bin/test) passes

require "yaml"
require "date"
require "time"
require "tmpdir"
require "open3"

ROOT = File.expand_path("..", __dir__)
Dir.chdir(ROOT)

failures = []
step = ->(name) { puts "== #{name}" }

Dir.mktmpdir("pingback-ci") do |site|
  step["Production build"]
  out, status = Open3.capture2e({ "JEKYLL_ENV" => "production" },
                                "bundle", "exec", "jekyll", "build", "--strict_front_matter", "-d", site)
  noisy = out.lines.grep(/error|warn|deprecat/i)
  if !status.success? || noisy.any?
    failures << "Build failed or warned:\n#{(noisy.any? ? noisy : out.lines.last(15)).join}"
  end

  step["Episode front matter"]
  required = %w[title episode description duration topics]
  tracked = `git ls-files -z`.split("\0")
  topic_slugs = Array(YAML.safe_load_file("_data/topics.yml")).map { |t| t["slug"] }
  to_secs = ->(t) { t.to_s.split(":").map(&:to_i).reduce(0) { |a, b| a * 60 + b } }
  now = Time.now
  Dir["_posts/*.md"].sort.each do |path|
    raw = File.read(path)
    fm = YAML.safe_load(raw[/\A---\n(.*?)\n---/m, 1].to_s, permitted_classes: [Date, Time]) || {}
    name = File.basename(path)
    failures << "#{name}: still has TODOs (finish the draft before pushing)" if raw.include?("TODO")

    missing = required.reject { |k| fm[k].to_s.strip != "" }
    failures << "#{name}: missing #{missing.join(", ")}" if missing.any?
    if [fm["youtube_id"], fm["buzzsprout_id"], fm["embed_url"], fm["audio_url"]].all? { |v| v.to_s.strip.empty? }
      failures << "#{name}: no youtube_id, buzzsprout_id, embed_url, or audio_url"
    end

    card = fm.dig("image", "path").to_s.delete_prefix("/")
    if card.empty?
      failures << "#{name}: no share card (run bin/og-cards #{fm["episode"]})"
    elsif !File.exist?(card)
      failures << "#{name}: share card #{card} is missing (run bin/og-cards #{fm["episode"]})"
    elsif !tracked.include?(card)
      failures << "#{name}: share card #{card} is not committed (git add it)"
    end

    limit = fm["duration"].to_s[/\d+/].to_i * 60 + 59
    chapter_secs = Array(fm["chapters"]).map { |c| to_secs.call(c["t"]) }
    failures << "#{name}: chapters are not in time order" unless chapter_secs == chapter_secs.sort
    failures << "#{name}: a chapter starts after the episode ends (#{fm["duration"]})" if chapter_secs.any? { |c| c > limit }
    Array(fm["moments"]).each.with_index(1) do |m, i|
      failures << "#{name}: moment #{i} at #{m["t"]} is after the episode ends (#{fm["duration"]})" if to_secs.call(m["t"]) > limit
      %w[title quote].each { |k| failures << "#{name}: moment #{i} has no #{k}" if m[k].to_s.strip.empty? }
      art = "assets/images/moments/episode-#{fm["episode"]}-#{i}.jpg"
      failures << "#{name}: moment #{i} art #{art} is missing or not committed (run bin/og-cards #{fm["episode"]})" unless tracked.include?(art)
      (Array(m["topics"]) - topic_slugs).each { |t| failures << "#{name}: moment #{i} has unknown topic #{t}" }
    end
    (Array(fm["topics"]) - topic_slugs).each { |t| failures << "#{name}: unknown topic #{t}" }

    date = fm["date"] || Date.parse(name[0, 10])
    date = date.to_time if date.respond_to?(:to_time)
    failures << "#{name}: dated #{date} which is in the future; Jekyll will not publish it" if date > now
  end

  step["Internal links and images"]
  Dir.glob("#{site}/**/*.html").each do |file|
    html = File.read(file)
    html.scan(/(?:href|src)="([^"]+)"/).flatten.uniq.each do |ref|
      next if ref.start_with?("http", "//", "mailto:", "#", "data:")

      target = ref.split(/[?#]/).first
      next if target.nil? || target.empty?

      path = File.join(site, target)
      ok = File.file?(path) || File.file?(File.join(path, "index.html")) || File.file?("#{path}.html")
      failures << "#{file.delete_prefix(site)}: broken link #{ref}" unless ok
    end
  end
end

step["Site tests"]
out, status = Open3.capture2e("bin/test")
failures << "Site tests failed:\n#{out.lines.grep(/Failure|Error|runs,|Expected/).first(20).join}" unless status.success?

if failures.empty?
  puts "CI passed."
else
  warn "\nCI FAILED:"
  failures.each { |f| warn "  - #{f}" }
  exit 1
end
